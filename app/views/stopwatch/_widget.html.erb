<div id="stopwatch-widget"
     data-state="<%= timer.state %>"
     data-elapsed-seconds="<%= timer.elapsed_seconds %>"
     data-started-at="<%= timer.started_at&.utc&.iso8601 %>"
     data-accumulated-seconds="<%= timer.accumulated_seconds %>"
     data-start-url="<%= stopwatch_start_path %>"
     data-pause-url="<%= stopwatch_pause_path %>"
     data-resume-url="<%= stopwatch_resume_path %>"
     data-snap-url="<%= stopwatch_snap_path %>"
     data-stop-url="<%= stopwatch_stop_path %>"
     data-segments-url="<%= stopwatch_segments_path %>"
     data-timer-context-label="<%= timer_context[:label] %>"
     data-timer-context-url="<%= timer_context[:url] %>"
     data-timer-issue-id="<%= timer_context[:issue_id] %>"
     data-timer-project-id="<%= timer_context[:project_id] %>"
     data-page-context-label="<%= page_context[:label] %>"
     data-page-context-url="<%= page_context[:url] %>"
     data-page-issue-id="<%= page_context[:issue_id] %>"
     data-page-project-id="<%= page_context[:project_id] %>"
     data-pending-count="<%= pending_count %>"
     data-reserved-paths="<%= StopwatchHookListener::RESERVED_PROJECT_PATH_SEGMENTS.join(',') %>"
     data-user-id="<%= User.current.id %>">
</div>
